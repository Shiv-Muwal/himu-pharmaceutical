PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/himu-pharmacy
USE_MEMORY_DB=false
AUTO_SEED=true
# Production MUST set a unique random JWT_SECRET (32+ chars). Server refuses to start without it.
JWT_SECRET=use-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Initial admin (used ONLY on first empty DB seed). Never logged to console.
# After first login, change password from Admin panel — restart will NOT reset it.
ADMIN_EMAIL=admin@himu.local
ADMIN_PASSWORD=change-me-on-first-setup
CUSTOMER_EMAIL=customer@himu.local
CUSTOMER_PASSWORD=change-me-demo-customer
CUSTOMER_NAME=Demo Customer
CUSTOMER_PHONE=9876543210
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://sitetest.himupharmaceutical.com,https://himupharmaceutical.com,https://www.himupharmaceutical.com

# Cloudinary (Admin product / banner image uploads)
# Get these from https://console.cloudinary.com/console → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=himu-pharmaceutical

# SMTP — OTP emails are sent FROM this address to the new user's email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=HIMU Pharmaceutical <admin@yourdomain.com>

# --- Production checklist ---
# NODE_ENV=production
# AUTO_SEED=false
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.../himu-pharmacy
# JWT_SECRET=<openssl rand -hex 32>
# ADMIN_PASSWORD=<unique strong password>
# CLOUDINARY_* set
