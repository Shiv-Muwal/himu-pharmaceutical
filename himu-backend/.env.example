PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/himu-pharmacy
USE_MEMORY_DB=false
AUTO_SEED=true
# Production MUST set a unique random JWT_SECRET (32+ chars). Server refuses to start without it.
JWT_SECRET=use-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Shared demo logins (dev only). Production MUST override ADMIN_PASSWORD — default is blocked.
ADMIN_EMAIL=admin@himu.local
ADMIN_PASSWORD=HimuAdmin@2026
CUSTOMER_EMAIL=customer@himu.local
CUSTOMER_PASSWORD=HimuCustomer@2026
CUSTOMER_NAME=Demo Customer
CUSTOMER_PHONE=9876543210
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://sitetest.himupharmaceutical.com,https://himupharmaceutical.com,https://www.himupharmaceutical.com

# Cloudinary (Admin product / banner image uploads)
# Get these from https://console.cloudinary.com/console → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=himu-pharmaceutical

# SMTP for signup email OTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Production checklist ---
# NODE_ENV=production
# AUTO_SEED=false
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.../himu-pharmacy
# JWT_SECRET=<openssl rand -hex 32>
# ADMIN_PASSWORD=<unique strong password>
# CLOUDINARY_* set
