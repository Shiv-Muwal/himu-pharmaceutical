# Local Vite only. Production builds MUST leave this empty (same-origin /api).
# Never set a remote host like https://sitetest... — that breaks live login
# with net::ERR_NAME_NOT_RESOLVED when DNS is missing.
VITE_API_URL=http://localhost:5001/api
VITE_USE_LOCAL_ADMIN=false
VITE_ADMIN_URL=http://localhost:5174/admin/
