  <li>Categories</li>
  <li>Inventory</li>
  <li>Orders</li>
  <li>Customers</li>
  <li>Banners</li>
  <li>Blogs</li>
  <li><strong>Jobs</strong> — Add vacancy (name + JD)</li>
  <li>Settings</li>
</ul>

